# Plantilla de variables de entorno para el entorno piloto.
# Copiar como .env.pilot y rellenar los valores marcados con <...>.
# Generar secrets con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NUNCA commitear .env.pilot con valores reales.

DATABASE_URL=postgresql://clientra:<password>@<host>:<port>/clientra?schema=public
REDIS_URL=redis://<host>:6379
API_PORT=4000
NODE_ENV=production

JWT_ACCESS_SECRET=<generar-64-bytes-hex>
JWT_REFRESH_SECRET=<generar-64-bytes-hex>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

AI_PROVIDER=heuristic
OPENAI_API_KEY=

WHATSAPP_VERIFY_TOKEN=<token-propio-no-compartir>
WHATSAPP_APP_SECRET=<desde-meta-developer-portal>
WHATSAPP_ACCESS_TOKEN=<desde-meta-developer-portal>
WHATSAPP_PHONE_NUMBER_ID=<desde-meta-developer-portal>
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_TENANT_SLUG=<slug-del-tenant-principal>

CORS_ORIGINS=https://<url-del-frontend-en-produccion>
