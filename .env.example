# ─── Base de datos ───────────────────────────────────────────────
DATABASE_URL="postgresql://clientra:clientra@localhost:5432/clientra?schema=public"

# ─── Redis (cache + colas BullMQ) ────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ─────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ─── IA (capa desacoplada — opcional en H1) ──────────────────────
AI_PROVIDER="heuristic"   # heuristic | openai
OPENAI_API_KEY=""

# ─── WhatsApp Cloud API (H2) ─────────────────────────────────────
# Si WHATSAPP_ACCESS_TOKEN y WHATSAPP_PHONE_NUMBER_ID están vacíos, se usa
# el proveedor de consola (simula el envío) — útil para la demo local.
WHATSAPP_VERIFY_TOKEN="clientra-verify"
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_DEFAULT_TENANT_SLUG="demo"

# ─── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
